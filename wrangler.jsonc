{
  "main": "index.ts",
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-business-starter",
  "main": "./index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "business-db", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "worker/migrations" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "business-private-files" }
  ],
  "vars": { "APP_ORIGIN": "http://localhost:5173" }
}
